# Single-stage build with Bun
FROM oven/bun:latest

# Install ca-certificates for SSL/TLS connections
RUN apt-get update && apt-get install -y ca-certificates && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy source code
COPY . .

# Diagnostic: verify the build context actually contains the workspace tree.
# CI builds have been failing with files missing from the context (first the
# soniox patch, then packages/sdk) while identical local builds pass.
RUN echo "== /app top level ==" && ls -la && \
    echo "== packages ==" && ls -la packages/ && \
    echo "== workspace manifests ==" && \
    find . -maxdepth 3 -name package.json -not -path "./node_modules/*" | sort

# Install dependencies and ensure correct bun-types version
RUN bun install --frozen-lockfile && \
    rm -rf node_modules/@types/bun && \
    bun add -d bun-types@1.0.17

# Build packages in sequence (types → display-utils → sdk → utils → cloud)
RUN echo "🚀 Starting build process..." && \
    echo "⚙️ Building packages/types..." && \
    cd packages/types && bun run build && \
    echo "✅ Built packages/types..." && \
    echo "⚙️ Building packages/display-utils..." && \
    cd ../display-utils && bun run build && \
    echo "✅ Built packages/display-utils..." && \
    echo "⚙️ Building packages/sdk..." && \
    cd ../sdk && bun run build && \
    echo "✅ Built packages/sdk..." && \
    echo "⚙️ Building packages/utils..." && \
    cd ../utils && bun run build && \
    echo "✅ Built packages/utils..." && \
    echo "⚙️ Building packages/cloud..." && \
    cd ../cloud && bun run build && \
    echo "✅ Built packages/cloud..." && \
    echo "🎉 All packages built successfully! 🎉"

# Skip running tests in CI for now
RUN echo "⚠️ Skipping tests in CI build"

# Expose both ports
EXPOSE 80 8000

# Use Bun to run the application
ENV NODE_ENV=production
CMD ["echo", "Ready to run services"]
