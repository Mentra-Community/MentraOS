# Dependencies
node_modules
**/node_modules

# Workspace uses cloud/bun.lock only: nested lockfiles confuse install in Docker.
# IMPORTANT: no "!" negation patterns in this file. Porter's context packaging
# treats any negation as switching the whole file to allowlist mode and ships an
# almost-empty build context (plain docker handles negations fine, which is why
# local builds pass while porter CI builds fail). Nested lockfiles are excluded
# by explicit depth instead of **/bun.lock + !bun.lock.
packages/*/bun.lock
packages/*/*/bun.lock
tools/*/bun.lock
websites/*/bun.lock
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Logs
logs
*.log

# Build outputs
**/dist
**/build
**/.next
**/.nuxt
**/out
**/public/build
**/.cache

# Testing
coverage
.nyc_output

# Environment files (except .env.example)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# System Files
.DS_Store
Thumbs.db

# Editor directories and files
.idea
.vscode
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Temporary files
*.tmp
*.bak
*.swp
*~.nib
local.properties
.settings/
.loadpath
.project

# Docker files
.dockerignore
Dockerfile*
docker-compose*
.docker

