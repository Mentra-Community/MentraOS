# Base Configuration
# cloud/.env
# This file contains the base configuration for the AugmentOS Cloud backend.
NODE_ENV=development
CLOUD_VERSION=2.0.0
BASE_PORT=8000
PORT=80

ADMIN_EMAILS=alex1115alex@gmail.com,alex1115alex+tester@gmail.com,isaiah@mentra.glass,israelov@mentra.glass,cayden@mentra.glass,nicolo@mentra.glass,nirhbay@mentra.glass,roger@mentra.glass

# Additional Pre-installed Apps (optional, comma-separated package names)
# These apps will be added on top of the default pre-installed apps
# Example: ADDITIONAL_PRE_INSTALLED_APPS=com.mentra.mentraai.beta,com.custom.app
ADDITIONAL_PRE_INSTALLED_APPS=

# Auto-delete Apps (optional, comma-separated package names)
# Apps specified here will be automatically removed from users' installed apps when they connect
# Useful for deprecating or removing apps across all users
# Example: DELETE_APP_BY_PACKAGE_NAME=cloud.augmentos.mira,com.deprecated.app
DELETE_APP_BY_PACKAGE_NAME=

# =============================================================================
# SERVICES URLs (for Docker networking)
# =============================================================================
CLOUD_URL=cloud
CLOUD_HOST_NAME=cloud
PUBLIC_HOST_NAME=localhost:8002
CLOUD_PUBLIC_HOST_NAME=localhost:8002
CLOUD_LOCAL_HOST_NAME=cloud

# App service URLs (Docker container names)
APPSTORE_URL=appstore
LIVE_CAPTIONS_URL=live-captions
LIVE_TRANSLATION_URL=live-translation
DASHBOARD_MANAGER_URL=dashboard-manager
FLASH_URL=flash
ISAIAH_URL=isaiah
MIRA_URL=mira
NOTIFY_URL=notify

# =============================================================================
# DATABASE (Required)
# =============================================================================
# MongoDB - Use Atlas for production, local for development
# WARNING: If running MongoDB locally, ALWAYS bind to 127.0.0.1 only to prevent exposure
MONGO_URL=

# =============================================================================
# AUTHENTICATION (Required)
# =============================================================================
# Supabase - Required for user authentication
SUPABASE_URL=https://ykbiunzfbbtwlzdprmeh.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# JWT Secrets - Generate secure random strings with: openssl rand -base64 64
SUPABASE_JWT_SECRET=
AUGMENTOS_AUTH_JWT_SECRET=
JOE_MAMA_USER_JWT=

# RSA Private Key for TPA Auth - Generate with: openssl genrsa -out private.pem 2048
TPA_AUTH_JWT_PRIVATE_KEY=

# =============================================================================
# TRANSCRIPTION SERVICES (Required - at least one)
# =============================================================================
# NOTE: Transcription requires third-party API keys. There is no offline option.
# Soniox is the default provider, Azure Speech is the fallback.

# Soniox Speech (Default provider)
# Sign up at: https://soniox.com
SONIOX_API_KEY=

# Azure Speech (Fallback provider)
# Sign up at: https://azure.microsoft.com/en-us/products/cognitive-services/speech-services
AZURE_SPEECH_REGION=
AZURE_SPEECH_KEY=

# =============================================================================
# LLM CONFIGURATION (Currently Unused)
# =============================================================================
# NOTE: The LLM provider infrastructure exists but is NOT currently used by any
# features in the cloud. You can leave these empty or set dummy values.
# This section is preserved for future AI features.

LLM_MODEL=gpt-4o
LLM_PROVIDER=azure

# Azure OpenAI Configuration (not currently used)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_INSTANCE_NAME=
AZURE_OPENAI_API_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Anthropic Configuration (not currently used)
ANTHROPIC_API_KEY=

# OpenAI Configuration (not currently used)
OPENAI_API_KEY=

# =============================================================================
# MONITORING & LOGGING (Optional but Recommended)
# =============================================================================
# Sentry - Error tracking
SENTRY_DSN=

# PostHog - Analytics
POSTHOG_PROJECT_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# Better Stack - Log aggregation
BETTERSTACK_SOURCE_TOKEN=

# =============================================================================
# EXTERNAL SERVICES (Optional)
# =============================================================================
# Email Service - Resend
RESEND_API_KEY=

# Search API - SerpAPI (for web search features)
SERPAPI_API_KEY=

# Cloudflare - Storage and streaming
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Cloudflare R2 Configuration (object storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=mentra-store
R2_PUBLIC_URL=https://mentra-store-cdn.mentraglass.com

# LiveKit - Real-time audio/video
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=

# ElevenLabs - Text-to-Speech
ELEVENLABS_API_KEY=
ELEVENLABS_DEFAULT_VOICE_ID=

# Slack Webhooks - Notifications
SLACK_WEBHOOK_USER_FEEDBACK=
SLACK_WEBHOOK_MINI_APP_SUBMISSION=

# =============================================================================
# CHINA DEPLOYMENT (Optional)
# =============================================================================
# Set DEPLOYMENT_REGION=china to use Alibaba services instead of Azure/Soniox
DEPLOYMENT_REGION=global

# Alibaba DashScope (for China deployment only)
ALIBABA_ENDPOINT=
ALIBABA_WORKSPACE=
ALIBABA_DASHSCOPE_API_KEY=

# Authing (China auth provider)
AUTHING_APP_HOST=
AUTHING_APP_ID=
AUTHING_APP_SECRET=

# =============================================================================
# SYSTEM CONFIGURATION
# =============================================================================
SYSTEM_DASHBOARD_PACKAGE_NAME=system.augmentos.dashboard
TZ=America/Los_Angeles
