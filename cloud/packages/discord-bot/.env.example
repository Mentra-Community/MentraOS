# Discord Bot Configuration
# Get these from https://discord.com/developers/applications

# Bot Token - from Bot settings page
DISCORD_BOT_TOKEN=

# Application ID - from General Information page
DISCORD_CLIENT_ID=

# Your Discord server ID (right-click server > Copy Server ID)
DISCORD_GUILD_ID=

# The bug-reports forum channel ID (right-click channel > Copy Channel ID)
DISCORD_BUG_REPORT_CHANNEL_ID=

# Optional: Comma-separated list of channel IDs to watch for misplaced bugs
# If not set, watches all channels except bug-reports
# Example: 123456789,987654321
DISCORD_WATCHED_CHANNEL_IDS=

# Log level (debug, info, warn, error)
LOG_LEVEL=info
