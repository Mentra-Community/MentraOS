    "@mentra/client": ">=0.1",
    "@mentra/simulated-glasses": ">=0.1",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "@mentra/client": {
      "optional": true
    },
    "@mentra/simulated-glasses": {
