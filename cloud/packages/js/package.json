{
  "name": "@mentra/js",
  "version": "0.1.0",
  "description": "MentraOS app framework \u2014 build glasses apps like Next.js",
  "type": "module",
  "bin": {
    "mentra": "./cli.ts"
  },
  "main": "src/runtime/index.ts",
  "exports": {
    ".": "./src/runtime/index.ts",
    "./react": "./src/runtime/react.ts",
    "./dedupe-plugin": "./src/dedupe-plugin.ts",
    "./runtime": "./src/runtime/internals/index.ts",
    "./runtime/session": "./src/runtime/internals/session.ts",
    "./server": "./src/runtime/server.ts"
  },
  "scripts": {
    "dev": "bun run cli.ts dev",
    "build": "bun run cli.ts build"
  },
  "dependencies": {
    "@logtail/pino": "^0.5.4",
    "@mentra/types": "workspace:*",
    "@mentra/display-utils": "workspace:*",
    "axios": "^1.8.1",
    "chalk": "^5.6.2",
    "dotenv": "^16.4.0",
    "hono": "^4.11.3",
    "jimp": "^1.6.0",
    "jsonwebtoken": "^8.5.1",
    "jsrsasign": "^11.1.0",
    "lamejs": "^1.2.1",
    "pino": "^9.6.0",
