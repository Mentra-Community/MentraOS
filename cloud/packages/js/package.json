    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@mentra/client": "workspace:*",
    "@mentra/simulated-glasses": "workspace:*",
    "@types/bun": "latest",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/jsrsasign": "^10.5.15",
    "@types/ws": "^8.5.12",
    "typescript": "^5"
