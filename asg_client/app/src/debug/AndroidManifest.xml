<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Debug-only: print the BES crash incident bundles to logcat (tag BesIncident). -->
        <receiver
            android:name="com.mentra.asg_client.receiver.DebugBesIncidentReceiver"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.mentra.DEBUG_BES_INCIDENTS" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
