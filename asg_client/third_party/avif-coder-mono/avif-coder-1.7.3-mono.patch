+    /**
+     * Mentra fork addition: encode a raw 8-bit luma plane as a monochrome (YUV400) AVIF.
+     *
+     * Skips the Bitmap/RGBA round-trip entirely - the encoder consumes the single-channel
+     * buffer directly and emits a bitstream with no chroma planes.
+     *
+     * @param luma single-channel 8-bit buffer, row-major
+     * @param width image width in pixels
+     * @param height image height in pixels
+     * @param stride row stride in bytes (>= width); pass width for tightly packed buffers
+     * @param quality lossy quality 1..100
+     * @param speed AOM cpu-used 0..9 (higher = faster, slightly larger output);
+     *              -1 keeps the encoder plugin default
+     */
+    fun encodeAvifMono(
+        luma: ByteArray,
+        width: Int,
+        height: Int,
+        stride: Int = width,
+        quality: Int = 80,
+        speed: Int = -1
+    ): ByteArray {
+        require(quality in 1..100) {
+            throw IllegalStateException("Quality should be in 1..100 range")
+        }
+        require(speed in -1..9) {
+            throw IllegalStateException("Speed should be in -1..9 range")
+        }
+        require(width > 0 && height > 0) {
+            throw IllegalStateException("Invalid image dimensions")
+        }
+        require(stride >= width) {
+            throw IllegalStateException("Stride must be >= width")
+        }
+        require(luma.size >= stride * (height - 1) + width) {
+            throw IllegalStateException("Luma buffer too small for given dimensions")
+        }
+        return encodeAvifMonoImpl(luma, width, height, stride, quality, speed)
+    }
