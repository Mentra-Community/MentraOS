{
  "$schema": "./node_modules/@mentra/miniapp-cli/schema/miniapp.schema.json",
  "packageName": "com.mentra.local-captions",
  "version": "1.0.4",
  "name": "Local Captions",
  "description": "Local (island-runtime) port of the MentraOS Live Captions app. Subscribes to transcription, renders captions on the glasses display, and exposes a WebView for language + display settings.",
  "type": "standard",
  "sdkVersion": "0.2.0",
  "minHostVersion": "1.42.0",
  "port": 3100,
  "entry": {
    "background": "background/index.js",
    "ui": "ui/index.html"
  },
  "permissions": [
    {
      "type": "MICROPHONE",
      "description": "Used for live transcription"
    }
  ],
  "hardwareRequirements": [
    {
      "type": "DISPLAY",
      "level": "REQUIRED",
      "description": "Shows live transcription"
    },
    {
      "type": "MICROPHONE",
      "level": "REQUIRED",
      "description": "Captures speech for transcription"
    }
  ]
}
