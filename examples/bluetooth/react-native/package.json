{
  "name": "mentra-bluetooth-sdk-rn-example",
  "version": "0.1.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "expo": {
    "autolinking": {
      "exclude": [
        "@mentra/crust"
      ]
    }
  },
  "//": "Use android:dev for local Android development: it starts Metro, installs the dev build, forwards port 8081, and opens the Expo dev-client URL to avoid the first-run blank launcher.",
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "bun run ios:setup && expo run:ios",
    "ios:setup": "bash ./modules/mentra-video-stream-receiver/scripts/setup-gstreamer-ios.sh",
    "android": "node ./scripts/android-run.mjs",
    "android:dev": "node ./scripts/android-dev.mjs",
    "test": "bun test",
    "web": "expo start --web",
    "test:app-config": "node --test scripts/app-config-node-test.mjs"
  },
  "dependencies": {
    "@craftzdog/react-native-buffer": "^6.1.2",
    "@dr.pogodin/react-native-fs": "^2.37.0",
    "@mentra/bluetooth-sdk": "workspace:*",
    "@mentra/engine": "workspace:*",
    "@mentra/react-native-barcode-scanner": "file:modules/mentra-barcode-scanner",
    "@mentra/react-native-video-stream-receiver": "file:modules/mentra-video-stream-receiver",
    "@react-native-community/netinfo": "11.5.2",
    "axios": "^1.13.6",
    "expo": "~55.0.24",
    "expo-application": "~55.0.15",
    "expo-asset": "~55.0.17",
    "expo-audio": "~55.0.14",
    "expo-battery": "^55.0.13",
    "expo-build-properties": "~55.0.14",
    "expo-calendar": "~55.0.14",
    "expo-clipboard": "~55.0.13",
    "expo-constants": "~55.0.16",
    "expo-dev-client": "~55.0.34",
    "expo-device": "~55.0.17",
    "expo-file-system": "~55.0.20",
    "expo-linear-gradient": "~55.0.14",
    "expo-location": "~55.1.10",
    "expo-notifications": "~55.0.23",
    "expo-splash-screen": "~55.0.21",
    "expo-task-manager": "~55.0.16",
    "expo-video": "~55.0.17",
    "react": "19.2.0",
    "react-native": "0.83.6",
    "react-native-ble-manager": "^12.4.4",
    "react-native-localize": "^3.7.0",
    "react-native-marked": "8.1.1",
    "react-native-mmkv": "4.0.0",
    "react-native-nitro-bg-timer": "^0.1.0",
    "react-native-nitro-modules": "^0.31.10",
    "react-native-permissions": "^5.5.1",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-share": "^12.2.5",
    "react-native-svg": "15.15.3",
    "react-native-udp": "^4.1.7",
    "react-native-webview": "13.16.0",
    "react-native-wifi-reborn": "^4.13.6",
    "react-native-worklets": "0.7.4",
    "react-native-zip-archive": "7.1.1",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/react": "^19.1.0",
    "typescript": "~5.9.2",
    "ws": "^8.20.1"
  }
}
