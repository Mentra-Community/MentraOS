{
  "$schema": "./node_modules/@mentra/miniapp-cli/schema/miniapp.schema.json",
  "packageName": "com.mentra.store",
  "version": "1.0.3",
  "name": "Mentra Miniapp Store",
  "description": "Discover, install, update, and manage Mentra miniapps.",
  "icon": "icon.png",
  "type": "standard",
  "sdkVersion": "0.3.0",
  "minHostVersion": "2.13.0",
  "entry": {
    "background": "background/index.js",
    "ui": "ui/index.html"
  },
  "permissions": [],
  "hardwareRequirements": [],
  "actions": [
    {
      "id": "reconcile_updates",
      "description": "Check the Store catalog and install every eligible update owned by this Store.",
      "activation": "transient",
      "audience": "host",
      "parameters": {
        "type": "object",
        "properties": {}
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "checkedAt": {"type": "number"},
          "candidateCount": {"type": "number"}
        },
        "required": ["checkedAt", "candidateCount"]
      }
    }
  ],
  "port": 3180
}
