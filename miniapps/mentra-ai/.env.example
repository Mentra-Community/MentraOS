# Server port - The port on which the application will run (default: 3000)
PORT=3000

# App package name - Your application's unique identifier.  Make sure it exactly matches the package name in the MentraOS Developer Console
PACKAGE_NAME=org.yourname.appname

# API key - Your MentraOS developer API key from the MentraOS Developer Console
MENTRAOS_API_KEY=your_api_key_here

# ── Giga-agent delegation (optional) ────────────────────────────────────────
# When BOTH of the following are set, the fast agent gains an `ask_agent` tool
# that hands multi-step / personal-account / long-running work to the user's
# persistent agent (the testaiassistant control plane). Leave them unset to run
# Mentra AI standalone (no delegation).
#
# Control-plane origin (no trailing slash).
AGENTS_BASE_URL=https://agents.augmentos.app
# Shared server-to-server key (x-api-key). NEVER ship this to a device.
MENTRA_AGENT_API_KEY=your_control_plane_key_here
# Grace window (ms) a delegation blocks the turn before bailing to an ack +
# later follow-up. Defaults to 2000 to match the control plane.
# AGENT_DELEGATE_GRACE_MS=2000
#
# NOTE: PUBLIC_URL must be set (it already is, for audio/TTS) — the control
# plane POSTs delegation results to ${PUBLIC_URL}/api/agent/webhook.


