# Public URL baked into the miniapp background bundle.
# Local USB testing can use localhost if adb reverse tcp:3130 tcp:3130 is active.
# The miniapp dev sidecar uses 3123, so the backend uses 3130 in dev.
MENTRA_PUBLIC_MERGE_BACKEND_URL=http://localhost:3130

# Backend-only secrets. These are read by backend/src/index.ts and must never be
# prefixed with MENTRA_PUBLIC_.
GEMINI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
PORT=3130

# Miniapp backend auth. The miniapp sends a package-scoped Bearer token minted
# by Cloud Core. The backend verifies it against this JWKS and enforces
# aud=MERGE_PACKAGE_NAME.
MERGE_PACKAGE_NAME=com.mentra.local-merge
MENTRA_CORE_URL=http://localhost:3000
# MENTRA_AUTH_JWKS_URL=http://localhost:3000/.well-known/jwks.json
# MENTRA_AUTH_ISSUERS=cloud-core,mentra

# Optional Gemini Google Search grounding. Keep disabled unless you want public,
# current facts; private/project context should still come from transcript or
# explicit backend integrations.
MERGE_ENABLE_WEB_SEARCH=false

# Optional dev mode if you want the backend to return deterministic fake
# insights without a Gemini key.
MERGE_ALLOW_MOCK_INSIGHTS=false
