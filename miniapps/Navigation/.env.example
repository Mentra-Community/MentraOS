# Google Cloud Platform API key for the navigation miniapp.
# Powers the in-WebView map (Maps JavaScript API) and place search
# (Places API New). Get one at:
#   https://console.cloud.google.com/apis/credentials
# Restrict the key to those APIs and set quota caps before shipping —
# the key ships in the client bundle (visible to anyone who unzips the
# released miniapp), so quota is the only practical guardrail against
# abuse.
GOOGLE_NAV_API_KEY=your_key_here

# Build mode. `bun run build` reads this to gate dev-only UI
# (FloatingDevPanel, debug map overlays). `mentra-miniapp release`
# overrides this to "production" at spawn time so release builds
# always tree-shake the dev branches out regardless of what's here.
NODE_ENV=development
