# Public URL baked into the miniapp background bundle.
# Local USB testing can use localhost if adb reverse tcp:3131 tcp:3131 is active.
# The miniapp dev sidecar uses 3124, so the backend uses 3131 in dev.
MENTRA_PUBLIC_EVERYTHING_BACKEND_URL=http://localhost:3131

# Backend-only secrets. These are read by backend/src/index.ts and must never be
# prefixed with MENTRA_PUBLIC_.
ANTHROPIC_API_KEY=
EVERYTHING_MODEL=claude-opus-4-8
PORT=3131

# Miniapp backend auth. The miniapp sends a package-scoped Bearer token minted
# by Cloud Core. The backend verifies it against this JWKS and enforces
# aud=EVERYTHING_PACKAGE_NAME.
EVERYTHING_PACKAGE_NAME=com.mentra.everything
MENTRA_CORE_URL=http://localhost:3000
# MENTRA_AUTH_JWKS_URL=http://localhost:3000/.well-known/jwks.json
# MENTRA_AUTH_ISSUERS=cloud-core,mentra
