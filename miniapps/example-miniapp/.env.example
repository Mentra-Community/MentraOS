# Local ElevenLabs signing server (never bake the API key into the miniapp).
ELEVENLABS_API_KEY=<your-elevenlabs-api-key>
ELEVENLABS_AGENT_ID=agent_0301ks3wg64pf9evgxqa6dw34t1f
ELEVENLABS_SIGNING_SERVER_PORT=8788

# Baked into the miniapp at build/dev time (public only — no secrets).
# If unset, build.ts defaults the signed-URL endpoint to this Mac's LAN IP
# (e.g. http://192.168.x.x:8788/signed-url) so MentraOS on a phone can reach it.
MENTRA_PUBLIC_ELEVENLABS_AGENT_ID=agent_0301ks3wg64pf9evgxqa6dw34t1f
# MENTRA_PUBLIC_ELEVENLABS_SIGNED_URL_ENDPOINT=http://192.168.3.95:8788/signed-url
