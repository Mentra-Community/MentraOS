# Mentra AI (local miniapp) — environment
#
# Only vars prefixed MENTRA_PUBLIC_ are inlined into the bundle at build time
# (build.ts also re-exposes them without the prefix, e.g. MENTRA_PUBLIC_JINA_API_KEY
# is readable as both process.env.MENTRA_PUBLIC_JINA_API_KEY and process.env.JINA_API_KEY).
#
# ⚠️  Anything inlined here ships inside the JS bundle and is extractable.
#     Fine for local/dev. Before production, move these behind a backend proxy
#     and point src/background/lib/ai-config.ts at it instead.

# Gemini — powers the agent and the visual-query classifier
MENTRA_PUBLIC_GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key

# Jina — powers the web-search tool
MENTRA_PUBLIC_JINA_API_KEY=your_jina_api_key

# LLM model + provider label (shown in the system prompt)
MENTRA_PUBLIC_LLM_MODEL=gemini-3.1-flash-lite-preview
MENTRA_PUBLIC_LLM_PROVIDER=Google
