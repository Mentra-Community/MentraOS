# Mentra AI (local miniapp) — environment
#
# Architecture: the miniapp background bundle no longer holds AI keys. It calls
# a small backend (backend/src) that holds the secrets and runs Gemini + Jina
# server-side. The ONLY value baked into the bundle is the public backend URL.
#
# Secrets are managed in Doppler (project `mentra-ai`, config `dev`). The dev
# scripts use it automatically:
#   bun run dev            # backend + miniapp, secrets from Doppler
#   bun run backend:dev    # backend only, secrets from Doppler
# This .env file is only needed for the *:dev:local scripts (no Doppler).

# ── Public (inlined into the miniapp bundle by miniapp/build.ts) ─────────────
# Public URL the background bundle calls. For USB testing, point at localhost
# and run `adb reverse tcp:3131 tcp:3131`. The miniapp dev sidecar uses 3123,
# so the backend uses 3131 in dev.
MENTRA_PUBLIC_MENTRA_AI_BACKEND_URL=http://localhost:3131

# ── Backend-only secrets (read by backend/src, NEVER prefixed MENTRA_PUBLIC_) ─
# OpenRouter — powers the agent tool-loop and the visual-query classifier.
# Every model (Gemini / Claude / GPT) is served through OpenRouter's
# OpenAI-compatible API; the user picks the model in the miniapp settings.
OPENROUTER_API_KEY=your_openrouter_api_key

# Optional: ranking headers OpenRouter shows on its dashboards.
# OPENROUTER_SITE_URL=https://mentra.glass
# OPENROUTER_APP_TITLE=Mentra AI
# Optional: override the OpenRouter base URL (proxies / testing).
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Jina — powers the web-search tool.
JINA_API_KEY=your_jina_api_key

# Default model (OpenRouter slug) when the client sends none. The miniapp
# settings picker normally overrides this per request. Must be a slug from
# the model registry (backend/src/services/models.ts).
LLM_MODEL=google/gemini-3.1-flash-lite-preview

# Backend HTTP port.
PORT=3131

# ── Backend auth ────────────────────────────────────────────────────────────
# The miniapp sends a package-scoped Bearer token minted by Cloud Core. The
# backend verifies it against this JWKS and enforces aud=PACKAGE_NAME.
PACKAGE_NAME=com.mentra.ai.local
# Override only when testing against local/staging Core (prod JWKS is default):
# MENTRA_AUTH_JWKS_URL=http://localhost:3000/.well-known/jwks.json
# MENTRA_AUTH_ISSUERS=cloud-core,mentra
