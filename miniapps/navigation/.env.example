# Mapbox GL JS public tiles token (pk.…) for the front-end map. Required by
# build.ts and inlined into the UI bundle. Set it in .env for local builds; CI
# uses the PUBLIC_MAPBOX_TOKEN Actions variable.
#   https://account.mapbox.com/access-tokens/
PUBLIC_MAPBOX_TOKEN=

# Optional Google Static Maps key for src/test/bitmaps/fetch-static-maps.ts.
# Only the manual fixture generator uses this; the running miniapp uses Mapbox.
PUBLIC_MAP_NAV_VIEWER=your_maps_js_key_here
# Referer the fixture generator sends; must match one allowed by that key.
STATIC_MAPS_REFERER=https://console.mentra.glass/

# Build mode. `bun run build` reads this to gate dev-only UI
# (FloatingDevPanel, debug map overlays). `mentra-miniapp pack`/`release`
# override this to "production" so release builds always tree-shake the dev
# branches out regardless of what's here.
NODE_ENV=development
