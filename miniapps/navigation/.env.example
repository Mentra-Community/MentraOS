# Google Cloud Platform API key for the navigation miniapp's MAP ONLY.
# Powers the in-WebView map (Maps JavaScript API), which loads Google's
# script directly in the WebView and so CANNOT be proxied — this key ships
# in the UI bundle. Restrict it to the Maps JavaScript API + an HTTP-referrer
# restriction + a hard quota cap (quota is the only guardrail for a public key).
# Place search and reverse-geocoding do NOT use this key — they go through the
# miniapp SDK to the v2 cloud maps service (Mapbox), which holds the token.
#   https://console.cloud.google.com/apis/credentials
PUBLIC_MAP_NAV_VIEWER=your_maps_js_key_here

# Mapbox GL JS token (pk.…) for the front-end map (Mapbox migration). Same
# public token as mobile's EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN. Ships in the UI
# bundle. Restrict it with a URL/quota cap in the Mapbox account. Replaces
# PUBLIC_MAP_NAV_VIEWER once NavMap.tsx is ported to Mapbox GL JS.
#   https://account.mapbox.com/access-tokens/
PUBLIC_MAPBOX_TOKEN=your_mapbox_pk_token_here

# Build mode. `bun run build` reads this to gate dev-only UI
# (FloatingDevPanel, debug map overlays). `mentra-miniapp release`
# overrides this to "production" at spawn time so release builds
# always tree-shake the dev branches out regardless of what's here.
NODE_ENV=development
