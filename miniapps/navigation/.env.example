# Optional Google Static Maps key for src/test/bitmaps/fetch-static-maps.ts.
# Only the manual fixture generator uses this; the running miniapp uses Mapbox.
PUBLIC_MAP_NAV_VIEWER=your_maps_js_key_here

# Mapbox GL JS public tiles token (pk.…) for the front-end map. Ships in the UI
# bundle. Use the Mentra App tiles token; EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN is a
# fallback when PUBLIC_MAPBOX_TOKEN is absent. A token rotation requires a new
# miniapp version and ZIP: mobile CI ships the committed ZIP without rebuilding
# it, independently of the native app's MAPBOX_PUBLIC_TOKEN Actions secret.
#   https://account.mapbox.com/access-tokens/
PUBLIC_MAPBOX_TOKEN=your_mapbox_pk_token_here

# Build mode. `bun run build` reads this to gate dev-only UI
# (FloatingDevPanel, debug map overlays). `mentra-miniapp release`
# overrides this to "production" at spawn time so release builds
# always tree-shake the dev branches out regardless of what's here.
NODE_ENV=development
