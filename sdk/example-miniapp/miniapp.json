{
  "$schema": "./node_modules/@mentra/miniapp-cli/schema/miniapp.schema.json",
  "packageName": "com.mentra.example",
  "version": "1.0.0",
  "name": "Live Captions",
  "description": "Live transcription displayed on glasses in real time. Demonstrates @mentra/miniapp SDK: transcription events, text wall display, TTS, and button events.",
  "icon": "icon.png",
  "type": "standard",
  "sdkVersion": "0.2.0",
  "minHostVersion": "1.42.0",
  "entry": {
    "background": "dist/background/index.js",
    "ui": "dist/ui/index.html"
  },
  "permissions": [
    {"type": "MICROPHONE", "description": "Used for live transcription"},
    {"type": "LOCATION", "description": "Exercised by the SDK Tester page"},
    {"type": "READ_NOTIFICATIONS", "description": "Exercised by the SDK Tester page"},
    {"type": "CALENDAR", "description": "Exercised by the SDK Tester page"}
  ],
  "hardwareRequirements": [
    {"type": "DISPLAY", "level": "REQUIRED", "description": "Shows live transcription"},
    {"type": "MICROPHONE", "level": "REQUIRED", "description": "Captures speech for transcription"}
  ]
}
