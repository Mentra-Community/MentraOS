    "prepare": "bun src/index.ts schema regenerate"
  },
  "dependencies": {
    "@clack/prompts": "^1.2.0",
    "jszip": "^3.10.1",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@types/qrcode-terminal": "^0.12.0",
    "bun-types": "^1.3.14",
    "typescript": "^5.0.0"
  },
  "files": ["src", "schema"]
}
