{
  "name": "@mentra/miniapp-cli",
  "version": "0.1.0",
  "description": "Dev tools for MentraOS miniapps",
  "type": "module",
  "bin": {
    "mentra-miniapp": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
