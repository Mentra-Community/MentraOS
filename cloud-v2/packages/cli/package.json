{
  "name": "@mentra/cli",
  "version": "2.0.0-dev.2",
  "description": "Mentra developer CLI: sign in, and run, build and pack Mentra miniapps. Bun-only.",
  "type": "module",
  "bin": {
    "mentra": "./src/index.ts"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/testing"
  ],
  "engines": {
    "bun": ">=1.0.0"
  },
  "publishConfig": {
    "access": "public",
    "tag": "dev"
  },
  "scripts": {
    "dev": "bun src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mentra/miniapp-cli": "file:../../../sdk/miniapp-cli",
    "commander": "^14.0.2",
    "jszip": "^3.10.1",
    "openid-client": "6.8.8",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@mentra/workspace-contract": "workspace:*",
    "@types/bun": "1.3.14",
    "@types/qrcode": "^1.5.5"
  },
  "keywords": [
    "mentra",
    "mentraos",
    "cli",
    "miniapp"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mentra-Community/MentraOS.git",
    "directory": "cloud-v2/packages/cli"
  },
  "homepage": "https://github.com/Mentra-Community/MentraOS/tree/dev/cloud-v2/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/Mentra-Community/MentraOS/issues"
  }
}
