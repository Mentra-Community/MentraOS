{
  "$comment": "Shared by the protocol tests (miniapp-url.test.ts) and the engine tests, so Core and the Mentra App answer every case the same way. `null` means refused.",
  "normalize": [
    {"input": "https://notes.example.com", "expected": {"url": "https://notes.example.com/", "host": "notes.example.com", "kind": "public"}},
    {"input": "https://notes.example.com/app", "expected": {"url": "https://notes.example.com/app/", "host": "notes.example.com", "kind": "public"}},
    {"input": "https://notes.example.com/app/", "expected": {"url": "https://notes.example.com/app/", "host": "notes.example.com", "kind": "public"}},
    {"input": "HTTPS://Notes.Example.COM/App", "expected": {"url": "https://notes.example.com/App/", "host": "notes.example.com", "kind": "public"}, "why": "the scheme and host are lowercased; the path keeps its case"},
    {"input": "https://notes.example.com:443/app", "expected": {"url": "https://notes.example.com/app/", "host": "notes.example.com", "kind": "public"}, "why": "the default port is dropped"},
    {"input": "https://notes.example.com:8443/app", "expected": {"url": "https://notes.example.com:8443/app/", "host": "notes.example.com", "kind": "public"}},
    {"input": "https://notes.example.com./app", "expected": {"url": "https://notes.example.com/app/", "host": "notes.example.com", "kind": "public"}, "why": "a trailing dot names the same host"},
    {"input": "  https://notes.example.com/app  ", "expected": {"url": "https://notes.example.com/app/", "host": "notes.example.com", "kind": "public"}},
    {"input": "https://notes.example.com/a/./b/../c", "expected": {"url": "https://notes.example.com/a/c/", "host": "notes.example.com", "kind": "public"}},
    {"input": "https://alice.github.io/notes", "expected": {"url": "https://alice.github.io/notes/", "host": "alice.github.io", "kind": "public"}},
    {"input": "https://tools.acme.co.uk", "expected": {"url": "https://tools.acme.co.uk/", "host": "tools.acme.co.uk", "kind": "public"}},
    {"input": "https://miniapps.mentraglass.com/com.mentra.notes", "expected": {"url": "https://miniapps.mentraglass.com/com.mentra.notes/", "host": "miniapps.mentraglass.com", "kind": "public"}},
    {"input": "https://notes.my-site.com", "expected": {"url": "https://notes.my-site.com/", "host": "notes.my-site.com", "kind": "public"}},
    {"input": "https://xn--mnchen-3ya.de/notes", "expected": {"url": "https://xn--mnchen-3ya.de/notes/", "host": "xn--mnchen-3ya.de", "kind": "public"}},
    {"input": "https://93.184.215.14/notes", "expected": {"url": "https://93.184.215.14/notes/", "host": "93.184.215.14", "kind": "public"}, "why": "a public IP address is a valid URL, but no package name passes the domain rule on it"},
    {"input": "http://localhost:8080", "expected": {"url": "http://localhost:8080/", "host": "localhost", "kind": "local"}},
    {"input": "http://LOCALHOST:8080/app", "expected": {"url": "http://localhost:8080/app/", "host": "localhost", "kind": "local"}},
    {"input": "http://localhost:80/", "expected": {"url": "http://localhost/", "host": "localhost", "kind": "local"}},
    {"input": "http://10.0.0.5:3000/app", "expected": {"url": "http://10.0.0.5:3000/app/", "host": "10.0.0.5", "kind": "local"}},
    {"input": "https://10.0.0.5/app", "expected": {"url": "https://10.0.0.5/app/", "host": "10.0.0.5", "kind": "local"}},
    {"input": "http://127.1:8080", "expected": {"url": "http://127.0.0.1:8080/", "host": "127.0.0.1", "kind": "local"}, "why": "IPv4 shorthand is written out"},
    {"input": "http://[fd00::1]:8080", "expected": {"url": "http://[fd00::1]:8080/", "host": "[fd00::1]", "kind": "local"}},
    {"input": "http://[FD00:0:0:0:0:0:0:1]/", "expected": {"url": "http://[fd00::1]/", "host": "[fd00::1]", "kind": "local"}},
    {"input": "http://[::ffff:10.0.0.5]/", "expected": {"url": "http://[::ffff:a00:5]/", "host": "[::ffff:a00:5]", "kind": "local"}},
    {"input": "http://printer.local:8080/", "expected": {"url": "http://printer.local:8080/", "host": "printer.local", "kind": "local"}},
    {"input": "http://dev.localhost:5173", "expected": {"url": "http://dev.localhost:5173/", "host": "dev.localhost", "kind": "local"}},
    {"input": "http://notes.example.com/", "expected": null, "why": "HTTP is for local-network addresses only"},
    {"input": "http://93.184.215.14/", "expected": null},
    {"input": "https://user:secret@notes.example.com/", "expected": null, "why": "credentials"},
    {"input": "https://user@notes.example.com/", "expected": null},
    {"input": "https://@notes.example.com/", "expected": null},
    {"input": "https://notes.example.com/app?v=2", "expected": null, "why": "a query"},
    {"input": "https://notes.example.com/app?", "expected": null},
    {"input": "https://notes.example.com/app#top", "expected": null, "why": "a fragment"},
    {"input": "https://notes.example.com/app#", "expected": null},
    {"input": "https://münchen.de/", "expected": null, "why": "a host in Unicode; IDN hosts are written in their xn-- form"},
    {"input": "https://notes.example.com/ä/", "expected": null, "why": "non-ASCII; paths are percent-encoded"},
    {"input": "https://notes.example.com/a b/", "expected": null},
    {"input": "https://notes.example.com\\app", "expected": null},
    {"input": "https://notes..example.com/", "expected": null},
    {"input": "https://notes_app.example.com/", "expected": {"url": "https://notes_app.example.com/", "host": "notes_app.example.com", "kind": "public"}},
    {"input": "https://-notes.example.com/", "expected": null},
    {"input": "https://notes.example.com:99999/", "expected": null},
    {"input": "https:notes.example.com", "expected": null},
    {"input": "//notes.example.com/", "expected": null},
    {"input": "notes.example.com", "expected": null},
    {"input": "ftp://notes.example.com/", "expected": null},
    {"input": "javascript:alert(1)", "expected": null},
    {"input": "https://", "expected": null},
    {"input": "", "expected": null}
  ],
  "registrableDomain": [
    {"host": "notes.example.com", "expected": "example.com"},
    {"host": "example.com", "expected": "example.com"},
    {"host": "alice.github.io", "expected": "alice.github.io"},
    {"host": "notes.alice.github.io", "expected": "alice.github.io"},
    {"host": "tools.acme.co.uk", "expected": "acme.co.uk"},
    {"host": "miniapps.mentraglass.com", "expected": "mentraglass.com"},
    {"host": "miniapps.dev.mentraglass.com", "expected": "mentraglass.com"},
    {"host": "Notes.Example.COM", "expected": "example.com"},
    {"host": "notes.example.com.", "expected": "example.com"},
    {"host": "notes.my-site.com", "expected": "my-site.com"},
    {"host": "xn--mnchen-3ya.de", "expected": "xn--mnchen-3ya.de"},
    {"host": "shop.example.xn--p1ai", "expected": "example.xn--p1ai"},
    {"host": "com", "expected": null, "why": "a public suffix is nobody's domain"},
    {"host": "co.uk", "expected": null},
    {"host": "github.io", "expected": null},
    {"host": "93.184.215.14", "expected": null},
    {"host": "[2001:db8::1]", "expected": null},
    {"host": "localhost", "expected": null},
    {"host": "dev.localhost", "expected": null},
    {"host": "printer.local", "expected": null},
    {"host": "10.0.0.5", "expected": null},
    {"host": "fd00::1", "expected": null},
    {"host": "notes.corp.internal", "expected": null, "why": "a suffix the Public Suffix List doesn't know is owned by nobody"},
    {"host": "notes.acme.example", "expected": null},
    {"host": "printer.home.arpa", "expected": null},
    {"host": "notes..example.com", "expected": null},
    {"host": "notes.example.com:443", "expected": null, "why": "a host, not a URL or host and port"},
    {"host": "https://notes.example.com/", "expected": null},
    {"host": "user@notes.example.com", "expected": null},
    {"host": "", "expected": null}
  ],
  "packagePrefix": [
    {"host": "notes.example.com", "expected": "com.example"},
    {"host": "alice.github.io", "expected": "io.github.alice"},
    {"host": "tools.acme.co.uk", "expected": "uk.co.acme"},
    {"host": "miniapps.mentraglass.com", "expected": "com.mentraglass"},
    {"host": "NOTES.Example.COM.", "expected": "com.example"},
    {"host": "notes.my-site.com", "expected": "com.my_site"},
    {"host": "a--b.com", "expected": "com.a__b"},
    {"host": "xn--mnchen-3ya.de", "expected": "de.xn__mnchen_3ya"},
    {"host": "shop.example.xn--p1ai", "expected": "xn__p1ai.example"},
    {"host": "app.1password.com", "expected": null, "why": "a label that starts with a digit can't start a package part"},
    {"host": "my_site.com", "expected": null, "why": "only a hyphen becomes an underscore, so an underscore in the domain could collide with it"},
    {"host": "93.184.215.14", "expected": null},
    {"host": "localhost", "expected": null},
    {"host": "github.io", "expected": null}
  ],
  "localNetwork": [
    {"host": "localhost", "expected": true},
    {"host": "LOCALHOST", "expected": true},
    {"host": "localhost.", "expected": true},
    {"host": "dev.localhost", "expected": true},
    {"host": "printer.local", "expected": true},
    {"host": "alexs-macbook.local", "expected": true},
    {"host": "10.0.0.5", "expected": true},
    {"host": "10.255.255.255", "expected": true},
    {"host": "127.0.0.1", "expected": true},
    {"host": "127.1", "expected": true},
    {"host": "172.16.0.1", "expected": true},
    {"host": "172.31.255.255", "expected": true},
    {"host": "192.168.1.20", "expected": true},
    {"host": "169.254.10.1", "expected": true},
    {"host": "100.64.0.1", "expected": true, "why": "shared address space, used by overlay networks"},
    {"host": "100.127.255.255", "expected": true},
    {"host": "fd00::1", "expected": true},
    {"host": "[fd00::1]", "expected": true},
    {"host": "fc00::1", "expected": true},
    {"host": "fe80::1", "expected": true},
    {"host": "::1", "expected": true},
    {"host": "[::1]", "expected": true},
    {"host": "::ffff:10.0.0.5", "expected": true},
    {"host": "[::ffff:a00:5]", "expected": true},
    {"host": "local", "expected": false},
    {"host": "notes.example.com", "expected": false},
    {"host": "printer.local.example.com", "expected": false},
    {"host": "localhost.example.com", "expected": false},
    {"host": "172.15.255.255", "expected": false},
    {"host": "172.32.0.1", "expected": false},
    {"host": "192.169.0.1", "expected": false},
    {"host": "100.63.255.255", "expected": false},
    {"host": "100.128.0.1", "expected": false},
    {"host": "11.0.0.1", "expected": false},
    {"host": "8.8.8.8", "expected": false},
    {"host": "::ffff:8.8.8.8", "expected": false},
    {"host": "2001:db8::1", "expected": false},
    {"host": "::", "expected": false},
    {"host": "10.0.0.5:8080", "expected": false},
    {"host": "http://10.0.0.5/", "expected": false},
    {"host": "", "expected": false}
  ],
  "domainRule": [
    {"packageName": "com.example.notes", "url": "https://notes.example.com/", "allowed": true},
    {"packageName": "com.example.notes.pro", "url": "https://notes.example.com/app/", "allowed": true},
    {"packageName": "com.example.notes", "url": "https://example.com/", "allowed": true},
    {"packageName": "com.example", "url": "https://notes.example.com/", "allowed": false, "why": "the reversed domain needs at least one more part"},
    {"packageName": "com.other.notes", "url": "https://notes.example.com/", "allowed": false},
    {"packageName": "com.exampl.notes", "url": "https://notes.example.com/", "allowed": false},
    {"packageName": "com.example.notes", "url": "https://notes.example.com.evil.net/", "allowed": false},
    {"packageName": "com.example.notes", "url": "https://notes.examplex.com/", "allowed": false},
    {"packageName": "io.github.alice.notes", "url": "https://alice.github.io/notes/", "allowed": true},
    {"packageName": "io.github.bob.notes", "url": "https://alice.github.io/notes/", "allowed": false, "why": "each GitHub Pages user has their own namespace"},
    {"packageName": "io.github.notes", "url": "https://alice.github.io/", "allowed": false},
    {"packageName": "uk.co.acme.tools", "url": "https://tools.acme.co.uk/", "allowed": true},
    {"packageName": "uk.co.tools", "url": "https://tools.acme.co.uk/", "allowed": false},
    {"packageName": "com.mentra.notes", "url": "https://miniapps.mentraglass.com/com.mentra.notes/", "allowed": true, "why": "com.mentra.* belongs to mentraglass.com"},
    {"packageName": "com.mentra.notes", "url": "https://miniapps.dev.mentraglass.com/com.mentra.notes/", "allowed": true},
    {"packageName": "com.mentraglass.tools", "url": "https://mentraglass.com/tools/", "allowed": true},
    {"packageName": "com.mentra.notes", "url": "https://notes.example.com/", "allowed": false},
    {"packageName": "com.mentra.notes", "url": "https://mentra.com/notes/", "allowed": false, "why": "Mentra owns mentraglass.com, not mentra.com"},
    {"packageName": "com.mentra.notes", "url": "https://mentraglass.com.evil.example/", "allowed": false},
    {"packageName": "com.mentra.notes", "url": "https://notmentraglass.com/", "allowed": false},
    {"packageName": "com.mentra.notes", "url": "http://miniapps.mentraglass.com/com.mentra.notes/", "allowed": false},
    {"packageName": "com.mentra", "url": "https://mentraglass.com/", "allowed": false},
    {"packageName": "com.mentrax.notes", "url": "https://notes.mentrax.com/", "allowed": true},
    {"packageName": "com.my_site.notes", "url": "https://notes.my-site.com/", "allowed": true, "why": "a hyphen in a domain label is an underscore in the package name"},
    {"packageName": "com.my-site.notes", "url": "https://notes.my-site.com/", "allowed": false, "why": "package names have no hyphens"},
    {"packageName": "com.mysite.notes", "url": "https://notes.my-site.com/", "allowed": false},
    {"packageName": "de.xn__mnchen_3ya.notes", "url": "https://xn--mnchen-3ya.de/notes/", "allowed": true},
    {"packageName": "de.xn__mnchen_3ya.notes", "url": "https://münchen.de/notes/", "allowed": false},
    {"packageName": "com.example.notes", "url": "https://NOTES.Example.COM./app/", "allowed": true},
    {"packageName": "com.Example.notes", "url": "https://notes.example.com/", "allowed": false, "why": "package names are lowercase"},
    {"packageName": "com.example.Notes", "url": "https://notes.example.com/", "allowed": false},
    {"packageName": "com.example.1notes", "url": "https://notes.example.com/", "allowed": false},
    {"packageName": "com.example.", "url": "https://notes.example.com/", "allowed": false},
    {"packageName": "com.1password.notes", "url": "https://app.1password.com/", "allowed": false},
    {"packageName": "com.example.notes", "url": "https://93.184.215.14/", "allowed": false, "why": "an IP address has no registrable domain"},
    {"packageName": "com.example.notes", "url": "http://localhost:8080/", "allowed": false, "why": "a local-network address has no domain to own the name"},
    {"packageName": "com.example.notes", "url": "https://10.0.0.5/", "allowed": false},
    {"packageName": "com.example.notes", "url": "https://[fd00::1]/", "allowed": false},
    {"packageName": "local.printer.notes", "url": "https://printer.local/", "allowed": false},
    {"packageName": "internal.corp.notes", "url": "https://notes.corp.internal/", "allowed": false},
    {"packageName": "arpa.home.notes", "url": "https://notes.home.arpa/", "allowed": false},
    {"packageName": "com.example.notes", "url": "https://user:secret@notes.example.com/", "allowed": false},
    {"packageName": "com.example.notes", "url": "https://notes.example.com/miniapp.json", "allowed": true, "why": "only the host decides; the path doesn't"},
    {"packageName": "com.example.notes", "url": "https://cdn.example.com/notes/miniapp.json?sig=abc", "allowed": true, "why": "a query on a redirect target doesn't change its host"},
    {"packageName": "com.example.notes", "url": "notes.example.com", "allowed": false},
    {"packageName": "com.example.notes", "url": "", "allowed": false}
  ]
}
