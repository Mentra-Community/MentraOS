default_platform(:ios)

platform :ios do
  desc "Submit one exact existing TestFlight build to App Review"
  lane :promote_app_store do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_API_KEY_ID"),
      issuer_id: ENV.fetch("ASC_API_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_API_KEY_PATH"),
      duration: 1200,
    )

    deliver(
      api_key: api_key,
      app_identifier: ENV.fetch("APP_IDENTIFIER", "com.mentra.mentra"),
      app_version: ENV.fetch("MENTRA_MARKETING_VERSION"),
      build_number: ENV.fetch("MENTRA_BUILD_NUMBER"),
      submit_for_review: true,
      # Store approval must never make a production build public. The separate
      # protected store-release workflow performs that decision later.
      automatic_release: false,
      phased_release: ENV.fetch("MENTRA_PHASED_RELEASE", "true") == "true",
      force: true,
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: true,
      run_precheck_before_submit: false,
    )
  end
end
