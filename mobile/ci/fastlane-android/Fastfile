require "json"

default_platform(:android)

platform :android do
  desc "Read version codes from the selected Google Play track"
  lane :track_version_codes do
    output = ENV.fetch("GOOGLE_PLAY_VERSION_CODES_OUTPUT")
    codes = google_play_track_version_codes(track: ENV.fetch("GOOGLE_PLAY_TRACK", "internal"))
    File.write(output, JSON.generate(codes))
  end

  desc "Read current production and maximum allocated Google Play version codes"
  lane :google_play_inventory do
    output = ENV.fetch("GOOGLE_PLAY_INVENTORY_OUTPUT")
    tracks = ENV.fetch("GOOGLE_PLAY_INVENTORY_TRACKS", "internal,beta,production").split(",")
    versions = tracks.to_h do |track|
      [track, google_play_track_version_codes(track: track).map(&:to_i).sort]
    end
    all_codes = versions.values.flatten
    production_codes = versions.fetch("production", [])
    File.write(
      output,
      JSON.generate(
        {
          packageName: ENV.fetch("APP_PACKAGE_NAME", "com.mentra.mentra"),
          tracks: versions,
          currentVersionCode: production_codes.empty? ? nil : production_codes.max,
          maxVersionCode: all_codes.empty? ? 0 : all_codes.max,
        },
      ),
    )
  end

  desc "Upload AAB to the selected Google Play track"
  lane :google_play do
    upload_to_play_store(
      track: ENV.fetch("GOOGLE_PLAY_TRACK", "internal"),
      aab: ENV.fetch("GOOGLE_PLAY_AAB", "app/build/outputs/bundle/release/app-release.aab"),
      release_name: ENV["GOOGLE_PLAY_RELEASE_NAME"],
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
    )
  end

  desc "Promote one exact existing version code between Google Play tracks"
  lane :promote_google_play do
    source = ENV.fetch("GOOGLE_PLAY_SOURCE_TRACK")
    target = ENV.fetch("GOOGLE_PLAY_TARGET_TRACK", "production")
    version_code = Integer(ENV.fetch("GOOGLE_PLAY_VERSION_CODE"))
    output = ENV.fetch("GOOGLE_PLAY_PROMOTION_OUTPUT")

    source_codes = google_play_track_version_codes(track: source).map(&:to_i)
    UI.user_error!("Version code #{version_code} is absent from Google Play #{source}") unless source_codes.include?(version_code)
    target_codes = google_play_track_version_codes(track: target).map(&:to_i)
    reused = target_codes.include?(version_code)
    unless reused
      release_status = ENV.fetch("GOOGLE_PLAY_RELEASE_STATUS", "draft")
      rollout = ENV["GOOGLE_PLAY_ROLLOUT"]
      upload_to_play_store(
        track: source,
        track_promote_to: target,
        version_code: version_code,
        track_promote_release_status: release_status,
        rollout: rollout && Float(rollout),
        skip_upload_apk: true,
        skip_upload_aab: true,
        skip_upload_metadata: true,
        skip_upload_changelogs: true,
        skip_upload_images: true,
        skip_upload_screenshots: true,
      )
    end

    confirmed = google_play_track_version_codes(track: target).map(&:to_i)
    UI.user_error!("Google Play did not retain version code #{version_code} on #{target}") unless confirmed.include?(version_code)
    File.write(output, JSON.generate({ versionCode: version_code, source: source, target: target, reused: reused, releaseStatus: ENV.fetch("GOOGLE_PLAY_RELEASE_STATUS", "draft") }))
  end
end
