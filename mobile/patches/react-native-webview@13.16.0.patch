--- /dev/null
+++ b/apple/RNCMiniappSchemeHandler.h
@@ -0,0 +1,56 @@
+/**
+ * MentraOS patch: serves one miniapp package's files to its WebView.
+ *
+ * A page at miniapp://<packageName>/<path> gets the file at <rootDir>/<path>.
+ * Every other request the handler sees is refused with a 404: another
+ * package's host, "." or ".." segments, encoded separators, and any path that
+ * resolves outside rootDir once symlinks are followed. Responses carry a
+ * content type from the file extension and Cache-Control: no-store.
+ */
+
+#import <Foundation/Foundation.h>
+#import <WebKit/WebKit.h>
+
+NS_ASSUME_NONNULL_BEGIN
+
+/** The URL scheme miniapp pages load from: miniapp://<packageName>/<path>. */
+FOUNDATION_EXPORT NSString *const RNCMiniappOriginScheme;
+
+/** A response the handler sends: a status, its headers and the body. */
+@interface RNCMiniappResponse : NSObject
+@property (nonatomic, readonly) NSInteger statusCode;
+@property (nonatomic, copy, readonly) NSDictionary<NSString *, NSString *> *headers;
+@property (nonatomic, copy, readonly) NSData *body;
+@end
+
+@interface RNCMiniappSchemeHandler : NSObject <WKURLSchemeHandler>
+
+- (instancetype)initWithPackageName:(NSString *)packageName rootDir:(nullable NSString *)rootDir NS_DESIGNATED_INITIALIZER;
+- (instancetype)init NS_UNAVAILABLE;
+
+@property (atomic, copy, readonly) NSString *packageName;
+/** The active version's bundle root: an absolute path or a file:// URL. Updated in place when the version changes. */
+@property (atomic, copy, nullable) NSString *rootDir;
+
+/** Package names follow the miniapp rule: ^[a-z][a-z0-9_]*(\.[a-z][a-z0-9_]*)+$ */
++ (BOOL)isValidPackageName:(nullable NSString *)packageName;
+
+/**
+ * The regular file `url` names inside `rootDir`, with symlinks resolved, or
+ * nil when this package doesn't serve it.
+ */
++ (nullable NSString *)resolveFileForURL:(nullable NSURL *)url
+                             packageName:(nullable NSString *)packageName
+                                 rootDir:(nullable NSString *)rootDir;
+
+/** The Content-Type for a served file, from its extension. */
++ (NSString *)contentTypeForPath:(NSString *)path;
+
+/** The full response to `request`, read from disk. Safe to call off the main thread. */
++ (RNCMiniappResponse *)responseForRequest:(NSURLRequest *)request
+                               packageName:(nullable NSString *)packageName
+                                   rootDir:(nullable NSString *)rootDir;
+
+@end
+
+NS_ASSUME_NONNULL_END
