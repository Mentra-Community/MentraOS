@@ -0,0 +1,376 @@
+/**
+ * MentraOS patch: serves one miniapp package's files to its WebView.
+ * See RNCMiniappSchemeHandler.h.
+ */
+
+#import "RNCMiniappSchemeHandler.h"
+
+#include <errno.h>
+#include <fcntl.h>
+#include <limits.h>
+#include <stdlib.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+NSString *const RNCMiniappOriginScheme = @"miniapp";
+
+@interface RNCMiniappResponse ()
+- (instancetype)initWithStatusCode:(NSInteger)statusCode
+                           headers:(NSDictionary<NSString *, NSString *> *)headers
+                              body:(NSData *)body;
+@end
+
+@implementation RNCMiniappResponse
+- (instancetype)initWithStatusCode:(NSInteger)statusCode
+                           headers:(NSDictionary<NSString *, NSString *> *)headers
+                              body:(NSData *)body
+{
+  if ((self = [super init])) {
+    _statusCode = statusCode;
+    _headers = [headers copy];
+    _body = [body copy];
+  }
+  return self;
+}
+@end
+
+static NSString *RNCMiniappRealPath(NSString *path)
+{
+  if (path.length == 0) {
+    return nil;
+  }
+  char resolved[PATH_MAX];
+  if (realpath(path.fileSystemRepresentation, resolved) == NULL) {
+    return nil;
+  }
+  return [[NSFileManager defaultManager] stringWithFileSystemRepresentation:resolved length:strlen(resolved)];
+}
+
+/** rootDir arrives as an absolute path or a file:// URL. */
+static NSString *RNCMiniappRootPath(NSString *rootDir)
+{
+  if (rootDir.length == 0) {
+    return nil;
+  }
+  if ([rootDir.lowercaseString hasPrefix:@"file:"]) {
+    NSURL *url = [NSURL URLWithString:rootDir];
+    if (!url.isFileURL || url.path.length == 0) {
+      return nil;
+    }
+    return url.path;
+  }
+  return [rootDir hasPrefix:@"/"] ? rootDir : nil;
+}
+
+@implementation RNCMiniappSchemeHandler {
+  // Tasks WebKit hasn't stopped yet. Touched only on the main thread.
+  NSHashTable *_activeTasks;
+  dispatch_queue_t _ioQueue;
+}
+
+- (instancetype)initWithPackageName:(NSString *)packageName rootDir:(NSString *)rootDir
+{
+  if ((self = [super init])) {
+    _packageName = [packageName copy];
+    _rootDir = [rootDir copy];
+    _activeTasks = [NSHashTable hashTableWithOptions:NSPointerFunctionsStrongMemory | NSPointerFunctionsObjectPointerPersonality];
+    _ioQueue = dispatch_queue_create("com.reactnativecommunity.webview.miniapp-origin", DISPATCH_QUEUE_SERIAL);
+  }
+  return self;
+}
+
++ (BOOL)isValidPackageName:(NSString *)packageName
+{
+  if (packageName.length == 0 || packageName.length > 253) {
+    return NO;
+  }
+  static NSRegularExpression *pattern;
+  static dispatch_once_t onceToken;
+  dispatch_once(&onceToken, ^{
+    pattern = [NSRegularExpression regularExpressionWithPattern:@"^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$" options:0 error:nil];
+  });
+  return [pattern numberOfMatchesInString:packageName options:0 range:NSMakeRange(0, packageName.length)] == 1;
+}
+
++ (NSString *)resolveFileForURL:(NSURL *)url packageName:(NSString *)packageName rootDir:(NSString *)rootDir
+{
+  if (url == nil || ![self isValidPackageName:packageName]) {
+    return nil;
+  }
+  if (![url.scheme.lowercaseString isEqualToString:RNCMiniappOriginScheme]) {
+    return nil;
+  }
+  // Only this package's own host, with no port or credentials.
+  if (![url.host isEqualToString:packageName] || url.port != nil || url.user != nil || url.password != nil) {
+    return nil;
+  }
+
+  NSURLComponents *components = [NSURLComponents componentsWithURL:url resolvingAgainstBaseURL:NO];
+  NSString *rawPath = components.percentEncodedPath;
+  if (rawPath.length == 0 || ![rawPath hasPrefix:@"/"]) {
+    return nil;
+  }
+  NSString *lowerPath = rawPath.lowercaseString;
+  if ([lowerPath containsString:@"%2f"] || [lowerPath containsString:@"%5c"] || [lowerPath containsString:@"%00"] ||
+      [rawPath containsString:@"\\"]) {
+    return nil;
+  }
+
+  NSString *rootPath = RNCMiniappRealPath(RNCMiniappRootPath(rootDir));
+  if (rootPath == nil) {
+    return nil;
+  }
+  NSMutableArray<NSString *> *pathParts = [NSMutableArray arrayWithObject:rootPath];
+  for (NSString *segment in [rawPath componentsSeparatedByString:@"/"]) {
+    if (segment.length == 0) {
+      continue;
+    }
+    NSString *decoded = segment.stringByRemovingPercentEncoding;
+    if (decoded.length == 0 || [decoded isEqualToString:@"."] || [decoded isEqualToString:@".."] ||
+        [decoded containsString:@"/"] || [decoded containsString:@"\\"] ||
+        [decoded rangeOfString:@"\0"].location != NSNotFound) {
+      return nil;
+    }
+    [pathParts addObject:decoded];
+  }
+  if (pathParts.count < 2) {
+    return nil;
+  }
+
+  NSString *filePath = RNCMiniappRealPath([NSString pathWithComponents:pathParts]);
+  NSString *rootPrefix = [rootPath hasSuffix:@"/"] ? rootPath : [rootPath stringByAppendingString:@"/"];
+  if (filePath == nil || ![filePath hasPrefix:rootPrefix]) {
+    return nil;
+  }
+  struct stat info;
+  if (lstat(filePath.fileSystemRepresentation, &info) != 0 || !S_ISREG(info.st_mode)) {
+    return nil;
+  }
+  return filePath;
+}
+
++ (NSString *)contentTypeForPath:(NSString *)path
+{
+  static NSDictionary<NSString *, NSString *> *types;
+  static dispatch_once_t onceToken;
+  dispatch_once(&onceToken, ^{
+    types = @{
+      @"html" : @"text/html; charset=utf-8",
+      @"htm" : @"text/html; charset=utf-8",
+      @"js" : @"text/javascript; charset=utf-8",
+      @"mjs" : @"text/javascript; charset=utf-8",
+      @"cjs" : @"text/javascript; charset=utf-8",
+      @"css" : @"text/css; charset=utf-8",
+      @"json" : @"application/json; charset=utf-8",
+      @"map" : @"application/json; charset=utf-8",
+      @"webmanifest" : @"application/manifest+json; charset=utf-8",
+      @"txt" : @"text/plain; charset=utf-8",
+      @"xml" : @"application/xml; charset=utf-8",
+      @"svg" : @"image/svg+xml",
+      @"png" : @"image/png",
+      @"jpg" : @"image/jpeg",
+      @"jpeg" : @"image/jpeg",
+      @"gif" : @"image/gif",
+      @"webp" : @"image/webp",
+      @"avif" : @"image/avif",
+      @"ico" : @"image/x-icon",
+      @"bmp" : @"image/bmp",
+      @"wasm" : @"application/wasm",
+      @"woff" : @"font/woff",
+      @"woff2" : @"font/woff2",
+      @"ttf" : @"font/ttf",
+      @"otf" : @"font/otf",
+      @"mp3" : @"audio/mpeg",
+      @"wav" : @"audio/wav",
+      @"ogg" : @"audio/ogg",
+      @"oga" : @"audio/ogg",
+      @"m4a" : @"audio/mp4",
+      @"aac" : @"audio/aac",
+      @"flac" : @"audio/flac",
+      @"mp4" : @"video/mp4",
+      @"m4v" : @"video/mp4",
+      @"webm" : @"video/webm",
+      @"mov" : @"video/quicktime",
+      @"ogv" : @"video/ogg",
+      @"pdf" : @"application/pdf",
+      @"glb" : @"model/gltf-binary",
+      @"gltf" : @"model/gltf+json",
+    };
+  });
+  return types[path.pathExtension.lowercaseString] ?: @"application/octet-stream";
+}
+
++ (RNCMiniappResponse *)errorResponse:(NSInteger)statusCode extraHeaders:(NSDictionary<NSString *, NSString *> *)extraHeaders
+{
+  NSString *text = statusCode == 404 ? @"Not found" : statusCode == 405 ? @"Method not allowed" : @"Range not satisfiable";
+  NSData *body = [text dataUsingEncoding:NSUTF8StringEncoding];
+  NSMutableDictionary<NSString *, NSString *> *headers = [@{
+    @"Content-Type" : @"text/plain; charset=utf-8",
+    @"Content-Length" : [NSString stringWithFormat:@"%lu", (unsigned long)body.length],
+    @"Cache-Control" : @"no-store",
+    @"X-Content-Type-Options" : @"nosniff",
+  } mutableCopy];
+  [headers addEntriesFromDictionary:extraHeaders ?: @{}];
+  return [[RNCMiniappResponse alloc] initWithStatusCode:statusCode headers:headers body:body];
+}
+
+/**
+ * One "bytes=" range. Returns NO when the header asks for none we can serve
+ * (416); a header we don't understand, or several ranges, is ignored (200).
+ */
++ (BOOL)rangeFromHeader:(NSString *)header length:(unsigned long long)length range:(NSRange *)range present:(BOOL *)present
+{
+  *present = NO;
+  if (header.length == 0) {
+    return YES;
+  }
+  NSString *value = [header stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceCharacterSet]];
+  if (![value.lowercaseString hasPrefix:@"bytes="]) {
+    return YES;
+  }
+  NSString *spec = [value substringFromIndex:6];
+  if ([spec containsString:@","]) {
+    return YES;
+  }
+  NSArray<NSString *> *parts = [spec componentsSeparatedByString:@"-"];
+  if (parts.count != 2) {
+    return YES;
+  }
+  NSCharacterSet *nonDigits = [[NSCharacterSet decimalDigitCharacterSet] invertedSet];
+  NSString *first = [parts[0] stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceCharacterSet]];
+  NSString *last = [parts[1] stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceCharacterSet]];
+  if ((first.length && [first rangeOfCharacterFromSet:nonDigits].location != NSNotFound) ||
+      (last.length && [last rangeOfCharacterFromSet:nonDigits].location != NSNotFound) ||
+      (first.length == 0 && last.length == 0)) {
+    return YES;
+  }
+  unsigned long long start;
+  unsigned long long end;
+  if (first.length == 0) {
+    unsigned long long suffix = strtoull(last.UTF8String, NULL, 10);
+    if (suffix == 0 || length == 0) {
+      *present = YES;
+      return NO;
+    }
+    start = suffix >= length ? 0 : length - suffix;
+    end = length - 1;
+  } else {
+    start = strtoull(first.UTF8String, NULL, 10);
+    end = last.length ? strtoull(last.UTF8String, NULL, 10) : length - 1;
+    if (start >= length || end < start) {
+      *present = YES;
+      return NO;
+    }
+    if (end >= length) {
+      end = length - 1;
+    }
+  }
+  *present = YES;
+  *range = NSMakeRange((NSUInteger)start, (NSUInteger)(end - start + 1));
+  return YES;
+}
+
++ (RNCMiniappResponse *)responseForRequest:(NSURLRequest *)request packageName:(NSString *)packageName rootDir:(NSString *)rootDir
+{
+  NSString *method = request.HTTPMethod.uppercaseString ?: @"GET";
+  BOOL head = [method isEqualToString:@"HEAD"];
+  if (!head && ![method isEqualToString:@"GET"]) {
+    return [self errorResponse:405 extraHeaders:@{@"Allow" : @"GET, HEAD"}];
+  }
+  NSString *filePath = [self resolveFileForURL:request.URL packageName:packageName rootDir:rootDir];
+  if (filePath == nil) {
+    return [self errorResponse:404 extraHeaders:nil];
+  }
+
+  // The path has no symlinks left; refuse one swapped in since it was checked.
+  int fd = open(filePath.fileSystemRepresentation, O_RDONLY | O_NOFOLLOW | O_CLOEXEC);
+  if (fd < 0) {
+    return [self errorResponse:404 extraHeaders:nil];
+  }
+  struct stat info;
+  if (fstat(fd, &info) != 0 || !S_ISREG(info.st_mode)) {
+    close(fd);
+    return [self errorResponse:404 extraHeaders:nil];
+  }
+  unsigned long long length = (unsigned long long)info.st_size;
+
+  NSRange range = NSMakeRange(0, (NSUInteger)length);
+  BOOL partial = NO;
+  if (![self rangeFromHeader:[request valueForHTTPHeaderField:@"Range"] length:length range:&range present:&partial]) {
+    close(fd);
+    return [self errorResponse:416 extraHeaders:@{@"Content-Range" : [NSString stringWithFormat:@"bytes */%llu", length]}];
+  }
+
+  NSMutableData *body = [NSMutableData data];
+  if (!head && range.length > 0) {
+    body.length = range.length;
+    size_t done = 0;
+    while (done < range.length) {
+      ssize_t n = pread(fd, (char *)body.mutableBytes + done, range.length - done, (off_t)(range.location + done));
+      if (n < 0 && errno == EINTR) {
+        continue;
+      }
+      if (n <= 0) {
+        close(fd);
+        return [self errorResponse:404 extraHeaders:nil];
+      }
+      done += (size_t)n;
+    }
+  }
+  close(fd);
+
+  NSMutableDictionary<NSString *, NSString *> *headers = [@{
+    @"Content-Type" : [self contentTypeForPath:filePath],
+    @"Content-Length" : [NSString stringWithFormat:@"%lu", (unsigned long)range.length],
+    @"Cache-Control" : @"no-store",
+    @"X-Content-Type-Options" : @"nosniff",
+    @"Accept-Ranges" : @"bytes",
+  } mutableCopy];
+  if (partial) {
+    headers[@"Content-Range"] = [NSString stringWithFormat:@"bytes %lu-%lu/%llu", (unsigned long)range.location,
+                                                           (unsigned long)(range.location + range.length - 1), length];
+  }
+  return [[RNCMiniappResponse alloc] initWithStatusCode:partial ? 206 : 200 headers:headers body:body];
+}
+
+#pragma mark - WKURLSchemeHandler
+
+- (void)webView:(WKWebView *)webView startURLSchemeTask:(id<WKURLSchemeTask>)urlSchemeTask
+{
+  NSURLRequest *request = urlSchemeTask.request;
+  NSString *packageName = self.packageName;
+  NSString *rootDir = self.rootDir;
+  [_activeTasks addObject:urlSchemeTask];
+  __weak RNCMiniappSchemeHandler *weakSelf = self;
+  dispatch_async(_ioQueue, ^{
+    RNCMiniappResponse *response = [RNCMiniappSchemeHandler responseForRequest:request packageName:packageName rootDir:rootDir];
+    dispatch_async(dispatch_get_main_queue(), ^{
+      RNCMiniappSchemeHandler *strongSelf = weakSelf;
+      // WebKit throws if a stopped task is answered.
+      if (strongSelf == nil || ![strongSelf->_activeTasks containsObject:urlSchemeTask]) {
+        return;
+      }
+      [strongSelf->_activeTasks removeObject:urlSchemeTask];
+      NSHTTPURLResponse *httpResponse = [[NSHTTPURLResponse alloc] initWithURL:request.URL
+                                                                    statusCode:response.statusCode
+                                                                   HTTPVersion:@"HTTP/1.1"
+                                                                  headerFields:response.headers];
+      @try {
+        [urlSchemeTask didReceiveResponse:httpResponse];
+        if (response.body.length > 0) {
+          [urlSchemeTask didReceiveData:response.body];
+        }
+        [urlSchemeTask didFinish];
+      } @catch (NSException *exception) {
+        NSLog(@"[RNCMiniappSchemeHandler] could not answer %@: %@", request.URL, exception.reason);
+      }
+    });
+  });
+}
+
+- (void)webView:(WKWebView *)webView stopURLSchemeTask:(id<WKURLSchemeTask>)urlSchemeTask
+{
+  [_activeTasks removeObject:urlSchemeTask];
+}
+
+@end
