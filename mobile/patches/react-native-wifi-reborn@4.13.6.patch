+// Only safe enum/timing facts are logged. Reads run independently of apply/result.
+- (void)logApply:(RNWifiApplyDiagnostics *)diagnostics kind:(NSString *)kind phase:(NSString *)phase
+    requestedAt:(NSTimeInterval)requested state:(NSString *)state {
+    NSDictionary *facts = [diagnostics factsForKind:kind phase:phase requestedAt:requested state:state];
+    if (!facts) return;
+    NSData *data = [NSJSONSerialization dataWithJSONObject:facts options:0 error:nil];
+    if (data) os_log(OS_LOG_DEFAULT, "RNWIFI HOTSPOT_JOIN apply_observation %{public}@",
+        [[NSString alloc] initWithData:data encoding:NSUTF8StringEncoding]);
+}
+- (void)observeApply:(RNWifiApplyDiagnostics *)diagnostics ssid:(NSString *)ssid phase:(NSString *)phase requestedAt:(NSTimeInterval)requested {
+    if (![diagnostics factsForKind:@"target_configuration" phase:phase requestedAt:requested state:@"unavailable"]) return;
+    // Record when the read is actually issued, not when its work was scheduled.
+    requested = diagnostics.now;
+    // This request phase is not a snapshot guarantee: each reply includes its
+    // observed time and whether the original apply callback has already happened.
+    [self logApply:diagnostics kind:@"target_configuration" phase:phase requestedAt:requested state:@"unavailable"];
+    __weak WifiManager *weakSelf = self;
+    __weak RNWifiApplyDiagnostics *weakDiagnostics = diagnostics;
+    // Keep diagnostic state only for its read window; OS callbacks may arrive later.
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 2 * NSEC_PER_SEC), dispatch_get_global_queue(DISPATCH_QUEUE_PRIORITY_DEFAULT, 0), ^{
+        (void)diagnostics.now;
+    });
+    [[NEHotspotConfigurationManager sharedManager] getConfiguredSSIDsWithCompletionHandler:^(NSArray<NSString *> *configured) {
+        RNWifiApplyDiagnostics *current = weakDiagnostics;
+        if (current) [weakSelf logApply:current kind:@"target_configuration" phase:phase requestedAt:requested
+            state:RNWifiTargetConfigurationState(ssid, configured)];
+    }];
+    if ([phase isEqualToString:@"after_callback"]) {
+        [self logApply:diagnostics kind:@"association" phase:phase requestedAt:requested state:@"unavailable"];
+        [self getWifiSSID:^(NSString *observed) {
+            RNWifiApplyDiagnostics *current = weakDiagnostics;
+            if (current) [weakSelf logApply:current kind:@"association" phase:phase requestedAt:requested
+                state:RNWifiAssociationState(ssid, observed)];
+        }];
+    }
+}
