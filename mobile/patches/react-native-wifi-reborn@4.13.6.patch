diff --git a/ios/RNWifiErrorFacts.h b/ios/RNWifiErrorFacts.h
new file mode 100644
--- /dev/null
+++ b/ios/RNWifiErrorFacts.h
@@ -0,0 +1,37 @@
+#import <Foundation/Foundation.h>
+
+// Diagnostic identifiers only: never include localized text, credentials or userInfo.
+static inline NSString *RNWifiErrorDomain(NSString *domain) {
+    if (![domain isKindOfClass:[NSString class]] || domain.length == 0 || domain.length > 128) {
+        return @"unavailable";
+    }
+    NSCharacterSet *allowed = [NSCharacterSet characterSetWithCharactersInString:
+        @"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_.-"];
+    return [domain rangeOfCharacterFromSet:allowed.invertedSet].location == NSNotFound
+        ? domain : @"unavailable";
+}
+
+static inline NSString *RNWifiErrorFacts(NSError *error) {
+    id value = error.userInfo[NSUnderlyingErrorKey];
+    NSError *underlying = [value isKindOfClass:[NSError class]] ? value : nil;
+    return [NSString stringWithFormat:@"domain=%@ code=%ld underlying_domain=%@ underlying_code=%@",
+        RNWifiErrorDomain(error.domain), (long)error.code,
+        underlying ? RNWifiErrorDomain(underlying.domain) : @"none",
+        underlying ? [NSString stringWithFormat:@"%ld", (long)underlying.code] : @"none"];
+}
+
+// React Native replaces NSError.code with the library string code. Preserve
+// only bounded original facts, and certify that applyConfiguration answered.
+static inline NSError *RNWifiErrorWithNativeFacts(NSError *error) {
+    id value = error.userInfo[NSUnderlyingErrorKey];
+    NSError *underlying = [value isKindOfClass:[NSError class]] ? value : nil;
+    NSMutableDictionary *facts = [@{@"domain": RNWifiErrorDomain(error.domain),
+        @"code": @(error.code), @"completed": @YES} mutableCopy];
+    if (underlying) {
+        facts[@"underlying"] = @{@"domain": RNWifiErrorDomain(underlying.domain),
+            @"code": @(underlying.code)};
+    }
+    NSMutableDictionary *userInfo = [error.userInfo mutableCopy] ?: [NSMutableDictionary new];
+    userInfo[@"RNWifiNativeError"] = facts;
+    return [NSError errorWithDomain:error.domain code:error.code userInfo:userInfo];
+}
diff --git a/ios/RNWifiApplyDiagnostics.h b/ios/RNWifiApplyDiagnostics.h
new file mode 100644
--- /dev/null
+++ b/ios/RNWifiApplyDiagnostics.h
@@ -0,0 +1,72 @@
+#import <Foundation/Foundation.h>
+
+// One invocation's observational facts. No network identities or native userInfo.
+@interface RNWifiApplyDiagnostics : NSObject
+- (instancetype)initWithClock:(NSTimeInterval (^)(void))clock;
+- (void)applyStarted;
+- (void)applyCompleted;
+- (NSTimeInterval)now;
+- (NSUInteger)attempt;
+- (NSDictionary *)factsForKind:(NSString *)kind phase:(NSString *)phase
+    requestedAt:(NSTimeInterval)requestedAt state:(NSString *)state;
+@end
+
+@implementation RNWifiApplyDiagnostics {
+    NSTimeInterval (^_clock)(void);
+    NSTimeInterval _started, _apply, _callback;
+    NSUInteger _attempt;
+}
+static NSUInteger RNWifiLatestDiagnosticAttempt = 0;
+
+- (instancetype)init {
+    return [self initWithClock:^{ return NSProcessInfo.processInfo.systemUptime; }];
+}
+- (instancetype)initWithClock:(NSTimeInterval (^)(void))clock {
+    if ((self = [super init])) {
+        _clock = [clock copy]; _started = _clock(); _apply = -1; _callback = -1;
+        @synchronized (RNWifiApplyDiagnostics.class) { _attempt = ++RNWifiLatestDiagnosticAttempt; }
+    }
+    return self;
+}
+- (NSTimeInterval)now { return _clock(); }
+- (NSUInteger)attempt { return _attempt; }
+- (void)applyStarted { @synchronized (self) { _apply = _clock(); } }
+- (void)applyCompleted { @synchronized (self) { _callback = _clock(); } }
+- (NSDictionary *)factsForKind:(NSString *)kind phase:(NSString *)phase
+    requestedAt:(NSTimeInterval)requestedAt state:(NSString *)state {
+    NSTimeInterval observed = _clock();
+    @synchronized (RNWifiApplyDiagnostics.class) {
+        // An OS read is not cancellable. Drop late or superseded replies; never
+        // wait for a diagnostic read before applying or settling the native result.
+        if (_attempt != RNWifiLatestDiagnosticAttempt || observed - requestedAt > 2 ||
+            requestedAt < _started || observed < requestedAt) return nil;
+    }
+    BOOL association = [kind isEqualToString:@"association"];
+    BOOL configuration = [kind isEqualToString:@"target_configuration"];
+    BOOL result = [kind isEqualToString:@"apply_result"];
+    if ((!association && !configuration && !result) ||
+        ![@[@"before_apply", @"apply_admission", @"after_callback"] containsObject:phase]) return nil;
+    NSArray *states = association ? @[@"matched", @"different", @"unavailable"]
+        : configuration ? @[@"present", @"absent", @"unavailable"] : @[@"answered_error", @"answered_success"];
+    if (![states containsObject:state]) return nil;
+    @synchronized (self) {
+        NSMutableDictionary *facts = [@{@"attempt": @(_attempt), @"kind": kind, @"request_phase": phase,
+            @"requested_elapsed_ms": @((requestedAt - _started) * 1000),
+            @"observed_elapsed_ms": @((observed - _started) * 1000), @"state": state,
+            @"callback_observed": @(_callback >= 0)} mutableCopy];
+        if (_apply >= 0) facts[@"apply_elapsed_ms"] = @((_apply - _started) * 1000);
+        if (_callback >= 0) facts[@"callback_elapsed_ms"] = @((_callback - _started) * 1000);
+        return facts;
+    }
+}
+@end
+
+static inline NSString *RNWifiAssociationState(NSString *target, NSString *observed) {
+    if (![observed isKindOfClass:NSString.class] || !observed.length) return @"unavailable";
+    return [target isEqualToString:observed] ? @"matched" : @"different";
+}
+static inline NSString *RNWifiTargetConfigurationState(NSString *target, NSArray *configured) {
+    if (![configured isKindOfClass:NSArray.class]) return @"unavailable";
+    for (id value in configured) if (![value isKindOfClass:NSString.class]) return @"unavailable";
+    return [configured containsObject:target] ? @"present" : @"absent";
+}
