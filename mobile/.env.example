# ─────────────────────────────────────────────────────────────────────────────
# MAPBOX TOKENS — easiest way to get them: Doppler (no manual file editing).
#   doppler login                 # one-time
#   doppler setup                 # from mobile/, reads mobile/doppler.yaml
#   doppler run -- bun android    # (or: bun ios) — both tokens injected
# Doppler injects the real pk. + sk. so navigation works without touching the
# dummies below or ~/.gradle/.netrc. Plain `bun android`/`bun ios` (no Doppler)
# still works IF you set the sk. manually (see ~/.gradle + ~/.netrc notes below).
# Doppler is opt-in; CI uses GitHub Actions secrets, not Doppler.
# ─────────────────────────────────────────────────────────────────────────────
# Mapbox runtime token (pk.…) — boots the Mapbox Navigation SDK v3 on BOTH
# platforms now (iOS migrated off the Google Nav SDK to match Android) and is
# also reused by the navigation miniapp's Mapbox GL JS map. Public token, safe
# to ship; injected as:
#   • Android: AndroidManifest meta-data (com.mapbox.token) by mobile/plugins/android.ts
#   • iOS:     Info.plist MBXAccessToken by app.config.ts
# The SECRET Downloads:Read token (sk.…) is a separate build-time-only
# credential — Android reads it from ~/.gradle/gradle.properties as
# MAPBOX_DOWNLOADS_TOKEN; iOS reads it from the CocoaPods/SPM netrc. It must
# NEVER be committed or shipped.
# Dummy value so CI / local builds without the real token pass the validators.
# See issues/mapbox-navigation-migration.md.
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=ci-dummy-not-a-real-token

# Mapbox SECRET Downloads:Read token (sk.…) — build-time only, NEVER shipped.
# Used by the @rnmapbox/maps config plugin (RNMapboxMapsDownloadToken) so SPM
# can fetch the Mapbox Maps + Navigation iOS binaries during `pod install` /
# prebuild. On iOS you ALSO need this same token in ~/.netrc:
#   machine api.mapbox.com
#   login mapbox
#   password sk.…
# (Android reads the same secret from ~/.gradle/gradle.properties.)
# Mint one with the Downloads:Read scope at account.mapbox.com/access-tokens.
MAPBOX_DOWNLOADS_TOKEN=sk-ci-dummy-not-a-real-token

# Setting this environment variable changes the default value for the backend_url
# EXPO_PUBLIC_BACKEND_URL_OVERRIDE=https://api.mentra.glass

# Setting this environment variable changes the default value for the store_url
# EXPO_PUBLIC_STORE_URL_OVERRIDE=https://apps.mentra.glass


#EXPO_PUBLIC_BACKEND_URL_OVERRIDE=https://stagingapi.mentraglass.com
# EXPO_PUBLIC_STORE_URL_OVERRIDE=https://appsbeta.mentraglass.com

# Cloud V2 (core + runtime) default endpoints, applied at build time. Point
# every build at the Cloud V2 Dev environment by default (it auto-deploys from
# the dev branch). An in-app Dev Settings override still wins over these (see
# mobile/src/services/cloudClient.ts resolveUrl).
# Which environment this binary was built for: dev | staging | prod.
# Release lanes overwrite this and the two URLs below; a local build keeps dev.
# The app clears any stored cloud-URL override when this value changes, so a
# promoted build cannot keep talking to the environment a tester pinned.
EXPO_PUBLIC_BUILD_ENV=dev
EXPO_PUBLIC_CLOUD_CORE_URL=https://core.dev.us-west-2.mentraglass.com
EXPO_PUBLIC_CLOUD_STORE_URL=https://store.dev.us-west-2.mentraglass.com
EXPO_PUBLIC_CLOUD_RUNTIME_URL=https://runtime.dev.us-west-2.mentraglass.com

# Coordinated with BES MENTRA_SECURE_PAIRING. Keep false for Mentra 3.1;
# enable only after the two-phone Android/iOS hardware matrix passes.
EXPO_PUBLIC_ENABLE_MENTRA_LIVE_SECURE_PAIRING=false


# Only needed for LOCAL signed release builds — uncomment and fill in your own
# .env. Must stay commented out here: CI copies .env.example to .env verbatim,
# and injects the real values as env vars (.github/actions/inject-signing), so
# uncommented empty keys here would blank them out and silently downgrade the
# release build to debug signing (this broke Play internal uploads June 2026).
# ORG_GRADLE_PROJECT_MENTRAOS_UPLOAD_STORE_PASSWORD=
# ORG_GRADLE_PROJECT_MENTRAOS_UPLOAD_KEY_PASSWORD=
# ORG_GRADLE_PROJECT_MENTRAOS_UPLOAD_KEY_ALIAS=
# Background timers (react-native-nitro-bg-timer) are always on for Android —
# dev and release, no env var. If the native module is missing (dev client
# older than the module), the app raises a loud error telling you to rebuild
# with `bun android`; do that rather than looking for a way to disable it,
# because without it every engine timer and local miniapp freezes whenever
# the app is backgrounded.
