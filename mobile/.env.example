EXPO_PUBLIC_MENTRAOS_VERSION=2.12.0

# Apple Developer team identifier — required by scripts/release-ios.mjs.
# Not a secret (visible in every IPA's embedded provisioning profile).
APPLE_TEAM_ID=T5XXXL6N36

# Deployment region: global / china
EXPO_PUBLIC_DEPLOYMENT_REGION=global

# Supabase settings
EXPO_PUBLIC_SUPABASE_URL=https://ykbiunzfbbtwlzdprmeh.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InlrYml1bnpmYmJ0d2x6ZHBybWVoIiwicm9sZSI6ImFub24iLCJpYXQiOjE3MzQyODA2OTMsImV4cCI6MjA0OTg1NjY5M30.rbEsE8IRz-gb3-D0H8VAJtGw-xvipl1Nc-gCnnQ748U

# Posthog
EXPO_PUBLIC_POSTHOG_API_KEY=

# Sentry
EXPO_PUBLIC_SENTRY_DSN=

# Authing
EXPO_PUBLIC_AUTHING_APP_HOST=
EXPO_PUBLIC_AUTHING_APP_ID=

# Google Navigation SDK API keys (on-device map only).
# Per-platform keys, each locked in GCP to its app (iOS bundle ID / Android
# package + SHA-1). These power ONLY the on-device Navigation SDK map — the
# Routes/Geocoding web calls go through the cloud (GOOGLE_NAV_API_KEY in
# cloud/.env), so no web-service key ships in the app.
# Dummy values so CI / local builds without the real key don't trip the
# app.config.ts / android plugin validators. Set real keys in your local .env
# for the on-device map to render at runtime.
# iOS still uses the Google Nav SDK (its migration is deferred). Android
# moved to Mapbox, so EXPO_PUBLIC_GOOGLE_NAV_API_KEY_ANDROID is gone.
EXPO_PUBLIC_GOOGLE_NAV_API_KEY_IOS=ci-dummy-not-a-real-key

# Mapbox runtime token (pk.…) — boots the Mapbox Navigation SDK v3 on Android
# and is also reused by the navigation miniapp's Mapbox GL JS map. Public
# token, safe to ship; injected as AndroidManifest meta-data (com.mapbox.token)
# by mobile/plugins/android.ts. The SECRET Downloads:Read token (sk.…) is a
# separate build-time-only credential — it lives in ~/.gradle/gradle.properties
# as MAPBOX_DOWNLOADS_TOKEN and must NEVER be committed or shipped.
# Dummy value so CI / local builds without the real token pass the validators.
# See issues/mapbox-navigation-migration.md.
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=ci-dummy-not-a-real-token

# Setting this environment variable changes the default value for the backend_url
# EXPO_PUBLIC_BACKEND_URL_OVERRIDE=https://api.mentra.glass

# Setting this environment variable changes the default value for the store_url
# EXPO_PUBLIC_STORE_URL_OVERRIDE=https://apps.mentra.glass


#EXPO_PUBLIC_BACKEND_URL_OVERRIDE=https://stagingapi.mentraglass.com
# EXPO_PUBLIC_STORE_URL_OVERRIDE=https://appsbeta.mentraglass.com


# NEEDED FOR RELEASE BUILDING
ORG_GRADLE_PROJECT_MENTRAOS_UPLOAD_STORE_PASSWORD=
ORG_GRADLE_PROJECT_MENTRAOS_UPLOAD_KEY_PASSWORD=
ORG_GRADLE_PROJECT_MENTRAOS_UPLOAD_KEY_ALIAS=